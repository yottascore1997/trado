# ================================================================
# AI Intraday Signal Engine - Environment Configuration
# ================================================================

# Application
APP_NAME="AI Intraday Signal Engine"
APP_ENV="development"
DEBUG=true
PORT=8000
HOST="0.0.0.0"

# Database
# Default SQLite for local standalone development, PostgreSQL for production
DATABASE_URL="sqlite+aiosqlite:///./trading.db"
# Example PostgreSQL URL:
# DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/trading_db"

# Security & Authentication
JWT_SECRET="super-secret-key-change-this-in-production-min-32-chars-long"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Market Data Configuration
# Options: MOCK, UPSTOX, ZERODHA
MARKET_DATA_PROVIDER="MOCK"

# Broker APIs (Leave empty if using MOCK)
UPSTOX_CLIENT_ID=""
UPSTOX_CLIENT_SECRET=""
UPSTOX_REDIRECT_URI="http://localhost:8000/api/v1/auth/upstox/callback"
UPSTOX_ACCESS_TOKEN=""

ZERODHA_API_KEY=""
ZERODHA_API_SECRET=""
ZERODHA_ACCESS_TOKEN=""

# Telegram Bot Notifications (Optional)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
TELEGRAM_NOTIFICATIONS_ENABLED=false

# Risk & Signal Defaults
DEFAULT_CAPITAL=100000.0
RISK_PER_TRADE_PCT=0.5
MAX_DAILY_LOSS_PCT=1.0
MAX_TRADES_PER_DAY=5
MAX_CONSECUTIVE_LOSSES=2
MIN_RISK_REWARD=2.0
TRADING_START_TIME="09:20:00"
TRADING_END_TIME="15:10:00"
AI_SCORE_THRESHOLD=70.0

# Redis (Optional in local dev)
REDIS_URL="redis://localhost:6379/0"
